# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local development; set a separate PostgreSQL URL only with ENVIRONMENT=staging/production.
DATABASE_URL=sqlite:///./ai_edu.db

# LLM (at least one required for generation)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:3000,https://YOUR_VERCEL_DOMAIN

# Только локальная разработка без Supabase: фиксированный пользователь backend (не X-User-ID)
ENVIRONMENT=local
LOCAL_DEV_USER_ID=local-demo-user

# Ollama native API (рекомендуется для собственной локальной модели)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:7b

# Server RBAC / analytics. Bootstrap is a trusted CLI, never an unauthenticated endpoint.
INITIAL_ADMIN_EMAIL=
ANALYTICS_TIMEZONE=Asia/Almaty
# ENVIRONMENT must explicitly be local to enable LOCAL_DEV_USER_ID.
# Never combine ENVIRONMENT=local with a remote PostgreSQL DATABASE_URL: startup is refused.
# For staging/production: clear LOCAL_DEV_USER_ID, set ENVIRONMENT accordingly,
# apply the reviewed roles/analytics SQL migration before deploying the new backend.

# Render Free: leave REDIS_URL empty to use FastAPI BackgroundTasks.
# Gemini: set GEMINI_API_KEY and clear LLM_PROVIDER/LLM_BASE_URL/LLM_MODEL/LLM_API_KEY
# to use Gemini defaults; LLM_MODEL can override the Gemini model.
GEMINI_API_KEY=
FRONTEND_URL=
